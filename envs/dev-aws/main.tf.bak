terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = local.etiquettes
  }
}

locals {
  prefixe = "${var.projet}-${var.environnement}"

  etiquettes = {
    Projet      = var.projet
    Environment = var.environnement
    ManagedBy   = "terraform"
    Owner       = var.proprietaire
  }
}
